        <!--Postauth-->
        <con:pipeline type="request" name="request-PostauthPL">
            <con:stage id="_StageId-Postauth-req" name="StagePostauth">
                <con:context>
                    <con1:userNsDecl prefix="inn" namespace="http://TargetNamespace.com/Inn_Servicios_Sel_Suscriptor_Postauth_response" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                    <con1:userNsDecl prefix="osb_http" namespace="http://www.bea.com/wli/sb/transports/http" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                </con:context>
                <con:actions>
                    <con1:replace varName="body" contents-only="true" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-Postauth-replace</con2:id>
