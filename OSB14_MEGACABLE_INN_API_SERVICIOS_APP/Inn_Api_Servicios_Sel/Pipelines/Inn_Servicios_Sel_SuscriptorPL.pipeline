        </con:pipeline>
        <con:pipeline type="response" name="response-PostauthPL">
            <con:stage id="_StageId-Postauth-resp" name="StagePostauthResp">
                <con:context>
                    <con1:userNsDecl prefix="types" namespace="http://xmlns.oracle.com/inn/serviciosweb/types" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                    <con1:userNsDecl prefix="inn" namespace="http://TargetNamespace.com/Inn_Servicios_Sel_Suscriptor_Postauth_response" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                </con:context>
                <con:actions>
                    <con1:ifThenElse xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-Postauth-resp-ifthen</con2:id>
                        <con1:case id="_BranchId-Postauth-resp-error">
                            <con1:condition>
                                <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$body/types:AuthResponse/types:repuesta/text()='ERROR'</con2:xqueryText>
                            </con1:condition>
                            <con1:actions>
                                <con1:insert varName="inbound">
                                    <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-Postauth-http500</con2:id>
