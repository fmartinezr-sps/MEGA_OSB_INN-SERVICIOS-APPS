                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f57fefb.N4193843a.0.19db117b498.N7ffe</con2:id>
                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">fn:concat('usermame: ',$inbound/ctx:transport/ctx:request/http:query-parameters/http:parameter[@name='username']/@value,' password: ',$inbound/ctx:transport/ctx:request/http:query-parameters/http:parameter[@name='password']/@value,' Auth: ',$inbound/ctx:transport/ctx:request/tp:headers/tp:user-header[@name='Authorization']/@value)</con2:xqueryText>
                        </con1:expr>
                    </con1:report>
                    <con1:replace varName="body" contents-only="true" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-PostLoginnuevo-replace</con2:id>
                        <con1:expr>
                            <con2:xsltTransform xmlns:con2="http://www.bea.com/wli/sb/stages/config">
                                <con2:resource ref="Inn_Api_Servicios_Sel/Resources/Transformations/Request_PostLoginnuevo"/>
                                <con2:input>$body</con2:input>
                                <con2:param name="authorization">
                                    <con2:path>$inbound/ctx:transport/ctx:request/tp:headers/tp:user-header[@name='Authorization']/@value</con2:path>
                                </con2:param>
                                <con2:param name="username">
                                    <con2:path>$inbound/ctx:transport/ctx:request/http:query-parameters/http:parameter[@name='username']/@value</con2:path>
                                </con2:param>
                                <con2:param name="password">
                                    <con2:path>$inbound/ctx:transport/ctx:request/http:query-parameters/http:parameter[@name='password']/@value</con2:path>
                                </con2:param>
                            </con2:xsltTransform>
                        </con1:expr>
                    </con1:replace>
                    <con1:wsCallout xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-PostLoginnuevo-callout</con2:id>
                        <con1:service ref="Inn_Api_Servicios_Sel/BusinessServices/Inn_Servicios_Web_BS" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                        <con1:operation>LoginNuevo</con1:operation>
                        <con1:request>
                            <con1:body wrapped="true">body</con1:body>
                        </con1:request>
                        <con1:response>
                            <con1:body wrapped="true">body</con1:body>
                        </con1:response>
                        <con1:requestTransform/>
                        <con1:responseTransform/>
