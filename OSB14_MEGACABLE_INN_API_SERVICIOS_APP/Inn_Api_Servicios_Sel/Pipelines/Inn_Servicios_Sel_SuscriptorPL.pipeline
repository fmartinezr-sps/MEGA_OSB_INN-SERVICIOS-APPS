            <con:stage id="_StageId-PostLoginnuevo-req" name="StagePostLoginnuevo">
                <con:context>
                    <con1:userNsDecl prefix="inn" namespace="http://TargetNamespace.com/Inn_Servicios_Sel_Suscriptor_PostLogin_request" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                    <con1:userNsDecl prefix="osb_http" namespace="http://www.bea.com/wli/sb/transports/http" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
