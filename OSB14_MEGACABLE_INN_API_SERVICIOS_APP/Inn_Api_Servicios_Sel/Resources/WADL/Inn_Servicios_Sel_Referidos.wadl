  </grammars>

  <resources>
    <resource path="/generaCodigo">
      <method name="POST" soa:wsdlOperation="GenerarCodigo">
        <request>
          <representation mediaType="application/json" element="cns:Root-Element" xmlns:cns="http://TargetNamespace.com/Inn_Servicios_Sel_Referidos_GenerarCodigo_request"/>
        </request>
        <response status="200">
