                                    <con1:expr>
                                        <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config"><![CDATA[<tns:Root-Element xmlns:tns="http://TargetNamespace.com/Inn_Servicios_Sel_Suscriptor_PostLoginnuevo_fault">
         <tns:status>{$body/types:LoginNuevoResponse/types:status/text()}</tns:status>
         <tns:code>{$body/types:LoginNuevoResponse/types:code/text()}</tns:code>
         <tns:description>{$body/types:LoginNuevoResponse/types:description/text()}</tns:description>
         <tns:IdSuscriptor></tns:IdSuscriptor>
         <tns:vencido>{$body/types:LoginNuevoResponse/types:vencido/text()}</tns:vencido>
      </tns:Root-Element>]]></con2:xqueryText>
                                    </con1:expr>
                                </con1:assign>
                                <con1:replace contents-only="true" varName="body">
                                    <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f57ff64.N608edf9.0.19e2399dd1a.N7f51</con2:id>
                                    <con1:location>
