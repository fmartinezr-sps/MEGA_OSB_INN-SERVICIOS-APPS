        </response>
      </method>
    </resource>

    <resource path="/enviaCodigo">
      <method name="POST" soa:wsdlOperation="EnviarCodigo">
        <request>
          <representation mediaType="application/json" element="cns:Root-Element" xmlns:cns="http://TargetNamespace.com/Inn_Servicios_Sel_Referidos_EnviarCodigo_request"/>
        </request>
        <response status="200">
