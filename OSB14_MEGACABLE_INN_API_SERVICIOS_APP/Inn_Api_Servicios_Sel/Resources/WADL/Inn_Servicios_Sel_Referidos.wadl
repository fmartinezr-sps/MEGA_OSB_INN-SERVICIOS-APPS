<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns1="http://TargetNamespace.com/Inn_Servicios_Sel_Referidos_GenerarCodigo_request" xmlns:ns2="http://TargetNamespace.com/Inn_Servicios_Sel_Referidos_GenerarCodigo_response" xmlns:ns3="http://TargetNamespace.com/Inn_Servicios_Sel_Referidos_EnviarCodigo_request" xmlns:ns4="http://TargetNamespace.com/Inn_Servicios_Sel_Referidos_EnviarCodigo_response" xmlns:ns5="http://TargetNamespace.com/Inn_Servicios_Sel_Referidos_ValidarCodigo_response" xmlns:ns6="http://TargetNamespace.com/Inn_Servicios_Sel_Referidos_GetDescuentos_request" xmlns:ns7="http://TargetNamespace.com/Inn_Servicios_Sel_Referidos_GetDescuentos_response" xmlns="http://wadl.dev.java.net/2009/02">

  <doc title="Inn_Servicios_Sel_Referidos">RestService</doc>

  <grammars>
